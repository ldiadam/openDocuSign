<% account = @template&.account %>
<% if account&.logo&.attached? %>
  <a href="/" class="flex justify-center items-center">
    <img src="<%= ActiveStorage::Blob.proxy_path(account.logo.blob) %>" alt="<%= account.name %>" class="max-h-16 max-w-[240px] object-contain">
  </a>
<% else %>
  <h1 class="text-4xl md:text-5xl font-bold text-center"><%= account&.name || Docuseal.product_name %></h1>
<% end %>
