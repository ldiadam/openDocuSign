<% account = @submitter&.account %>
<% if account&.logo&.attached? %>
  <img src="<%= ActiveStorage::Blob.proxy_path(account.logo.blob) %>" alt="<%= account.name %>" class="max-h-10 md:max-h-12 max-w-[220px] object-contain mx-auto">
<% else %>
  <a href="<%= root_path %>" class="mx-auto text-2xl md:text-3xl font-bold items-center flex">
    <span><%= account&.name || Docuseal.product_name %></span>
  </a>
<% end %>
