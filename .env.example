# Public URL — required in production
APP_URL=https://sign.example.com

# Optional. Leave blank to auto-generate and persist in /data/docuseal/docuseal.env.
# If set, keep it stable: it encrypts signing certificates, SMTP credentials, and other configs.
SECRET_KEY_BASE=

# Non-secret defaults already set in the Dockerfile (override only if needed)
# CERT_COUNTRY=SG
# TIMESERVER_URL=http://timestamp.digicert.com
# RAILS_MAX_THREADS=15
# WEB_CONCURRENCY=0
# SIDEKIQ_THREADS=5

# Optional Postgres. Leave blank to use SQLite at /data/docuseal/db.sqlite3
# DATABASE_URL=postgres://user:password@postgres:5432/docuseal

# Optional SMTP. Can also be configured from Settings -> Email in the UI.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_DOMAIN=example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="DocuSeal <no-reply@example.com>"
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS=true

# Optional S3-compatible storage. Otherwise files go to /data/docuseal/attachments
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_ATTACHMENTS_BUCKET=
# S3_ENDPOINT=
